{
  "version": 2,
  "builds": [
    {
      "src": "librarysite/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "build": "pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "librarysite/wsgi.py"
    }
  ]
}